             if (save == null && this.lastEntitySaveNull) {
                 return false;
             }
 
-            MoonriseRegionFileIO.scheduleSave(this.world, this.chunkX, this.chunkZ, save, MoonriseRegionFileIO.RegionFileType.ENTITY_DATA);
