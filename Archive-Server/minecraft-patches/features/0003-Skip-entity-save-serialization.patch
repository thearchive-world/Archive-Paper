@@ -1803,7 +1803,8 @@ public final class NewChunkHolder {
                     return false;
                 }
                 try {
-                    mergeFrom = MoonriseRegionFileIO.loadData(this.world, this.chunkX, this.chunkZ, MoonriseRegionFileIO.RegionFileType.ENTITY_DATA, Priority.BLOCKING);
