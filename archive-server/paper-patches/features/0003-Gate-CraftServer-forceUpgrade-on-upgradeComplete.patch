From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: terbin <terbin.2b2t@gmail.com>
Date: Sun, 10 May 2026 00:00:00 +0000
Subject: [PATCH] Gate CraftServer forceUpgrade on upgradeComplete

CraftServer.createWorld invokes Main.forceUpgrade for plugin-created
worlds whenever --forceUpgrade is set. After minecraft-patch 0014
restored the up-front Main.main call, this is redundant for the initial
world load and incorrect for plugin-created worlds (which are fresh and
have no stale chunks). Skip the call when ArchiveSettings.upgradeComplete
is set.

diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 716c3b17dc07eb2417dfb0084fe75dbd270f031a..9621e13dbf3c4cfa5bcbf89390c157f88d5e5950 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1257,7 +1257,7 @@ public final class CraftServer implements Server {
 
         levelStemRegistry = contextRegistryAccess.lookupOrThrow(Registries.LEVEL_STEM);
 
-        if (this.console.options.has("forceUpgrade")) {
+        if (this.console.options.has("forceUpgrade") && !archive.ArchiveSettings.upgradeComplete()) { // The Archive - skip when Main.main already ran the upgrade
             net.minecraft.server.Main.forceUpgrade(this.console.storageSource, DataFixers.getDataFixer(), this.console.options.has("eraseCache"), () -> true, contextRegistryAccess, this.console.options.has("recreateRegionFiles"));
         }
 
