From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: terbin <terbin.2b2t@gmail.com>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] `upgradeChunks` CLI arg


diff --git a/src/main/java/org/bukkit/craftbukkit/Main.java b/src/main/java/org/bukkit/craftbukkit/Main.java
index 8b31c4a7cc3c8a0f212b56f83438dd833bbd927d..e488ef519231aa21cfc444826210dc3732b2eff5 100644
--- a/src/main/java/org/bukkit/craftbukkit/Main.java
+++ b/src/main/java/org/bukkit/craftbukkit/Main.java
@@ -150,6 +150,12 @@ public class Main {
                     .ofType(Boolean.class)
                     .defaultsTo(true)
                     .describedAs("Disable saving");
+
+                this.accepts("upgradeChunks", "Upgrade chunks to the current data version. Walks region/, entities/, and poi/ folders per dimension; each existing file is DFU'd in place via parallel direct-NBT (post-spin, no chunk-system involvement). Also DFU's the overworld data/minecraft/maps/<n>.dat and data/minecraft/maps/last_id.dat in place (single-threaded; map counts are tiny vs chunks). Tune worker count via --upgradeWorkerCount N. Pass --splitEntities to extract legacy embedded entities into entities/*.mca during the pass. Resumable via .archive-upgrade-progress.txt (deleted on clean completion). Server halts after the pass. Preferred over --forceUpgrade for archive-scale worlds: same DFU outcome, parallel, resumable, per-chunk failure tolerant. Part of the operator pipeline: upgradeChunks, then cleanDirtyChunks, then auditDirtyChunks; each as a separate invocation.")
+                    .withOptionalArg()
+                    .ofType(Boolean.class)
+                    .defaultsTo(true)
+                    .describedAs("Upgrade chunks");
             }
         };
 
