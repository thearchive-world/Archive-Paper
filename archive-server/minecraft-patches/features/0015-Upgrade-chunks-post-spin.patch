From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: terbin <terbin.2b2t@gmail.com>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] Upgrade chunks post-spin

After initServer has returned and one-tick init tasks have run, but
before the main tick loop opens, dispatch any of --upgradeChunks,
--cleanDirtyChunks, --bakeLight, or --auditDirtyChunks. The dispatcher
runs at most one pass per invocation, in the order
upgrade -> clean -> bake -> audit; each pass marks its phase complete
where applicable, and halts the server cleanly. The upgrade backend is parallel
direct-NBT (DirectNbtUpgrader): workers each own one region file and
DFU chunk NBT in place via SimpleRegionStorage.upgradeChunkTag, with
no chunk-system involvement. See docs/upgrade-pipeline-design.md for
rationale.

diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index c5dc23ff9a3cd30f7bae8ca896fede1a19e7a901..fa46403cf22e6f46c0f894b4f7ebe83da0868dfa 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1327,6 +1327,36 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                 CompletableFuture.runAsync(com.destroystokyo.paper.PaperVersionFetcher::getUpdateStatusStartupMessage, io.papermc.paper.util.MCUtil.ASYNC_EXECUTOR);
             }
             // Paper end - Improve outdated version checking
+            // The Archive start - upgrade chunks post-spin (first in dispatch; runs the pre-26.1 direct-NBT chunk upgrade pass)
+            if (archive.ArchiveSettings.upgradeChunksRequested()
+                    && !archive.ArchiveSettings.upgradeChunksComplete()) {
+                archive.ChunkUpgrader.run(this);
+                archive.ArchiveSettings.markUpgradeChunksComplete();
+                this.halt(false);
+                return;
+            }
+            // The Archive end - upgrade chunks post-spin
+            // The Archive start - clean dirty chunks post-spin (post-pass for --upgradeChunks)
+            if (archive.ArchiveSettings.cleanDirtyChunks()) {
+                archive.DirtNbtCleaner.run(this);
+                this.halt(false);
+                return;
+            }
+            // The Archive end - clean dirty chunks post-spin
+            // The Archive start - bake light post-spin (post-pass for --upgradeChunks + --cleanDirtyChunks)
+            if (archive.ArchiveSettings.bakeLight()) {
+                archive.BakeLightPass.run(this);
+                this.halt(false);
+                return;
+            }
+            // The Archive end - bake light post-spin
+            // The Archive start - audit dirty chunks post-spin (read-only verification; last in dispatch)
+            if (archive.ArchiveSettings.auditDirtyChunks()) {
+                archive.AuditDirtyChunks.run(this);
+                this.halt(false);
+                return;
+            }
+            // The Archive end - audit dirty chunks post-spin
 
             while (this.running) {
                 final long tickStart = System.nanoTime(); // Paper - improve tick loop
