From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rfresh2 <89827146+rfresh2@users.noreply.github.com>
Date: Sun, 16 Feb 2025 00:11:22 -0800
Subject: [PATCH] mute setBlockEntity logspam


diff --git a/net/minecraft/world/level/chunk/LevelChunk.java b/net/minecraft/world/level/chunk/LevelChunk.java
index a4b794781e66e6a054fb437bd0b66712b13320a4..772b1a47dbf85e4589c329a5156887bda7335eca 100644
--- a/net/minecraft/world/level/chunk/LevelChunk.java
+++ b/net/minecraft/world/level/chunk/LevelChunk.java
@@ -528,6 +528,7 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
         BlockPos pos = blockEntity.getBlockPos();
         BlockState blockState = this.getBlockState(pos);
         if (!blockState.hasBlockEntity()) {
+            if (true) return; // Archive - mute logspam
             // Paper start - ServerExceptionEvent
             com.destroystokyo.paper.exception.ServerInternalException e = new com.destroystokyo.paper.exception.ServerInternalException(
                 "Trying to set block entity %s at position %s, but state %s does not allow it".formatted(blockEntity, pos, blockState)
@@ -539,12 +540,12 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
             BlockState cachedBlockState = blockEntity.getBlockState();
             if (blockState != cachedBlockState) {
                 if (!blockEntity.getType().isValid(blockState)) {
-                    LOGGER.warn("Trying to set block entity {} at position {}, but state {} does not allow it", blockEntity, pos, blockState);
+                    LOGGER.debug("Trying to set block entity {} at position {}, but state {} does not allow it", blockEntity, pos, blockState);
                     return;
                 }
 
                 if (blockState.getBlock() != cachedBlockState.getBlock()) {
-                    LOGGER.warn("Block state mismatch on block entity {} in position {}, {} != {}, updating", blockEntity, pos, blockState, cachedBlockState);
+                    LOGGER.debug("Block state mismatch on block entity {} in position {}, {} != {}, updating", blockEntity, pos, blockState, cachedBlockState);
                 }
 
                 blockEntity.setBlockState(blockState);
