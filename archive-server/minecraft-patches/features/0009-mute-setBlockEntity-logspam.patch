From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rfresh2 <89827146+rfresh2@users.noreply.github.com>
Date: Sun, 16 Feb 2025 00:11:22 -0800
Subject: [PATCH] mute setBlockEntity logspam


diff --git a/net/minecraft/world/level/chunk/LevelChunk.java b/net/minecraft/world/level/chunk/LevelChunk.java
index 3acc1374a7ef968d88e9f566ce7b812fb8d580af..581f51d9b38ec931a5bf78f8d65a7fa182fd8127 100644
--- a/net/minecraft/world/level/chunk/LevelChunk.java
+++ b/net/minecraft/world/level/chunk/LevelChunk.java
@@ -532,6 +532,7 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
         BlockPos blockPos = blockEntity.getBlockPos();
         BlockState blockState = this.getBlockState(blockPos);
         if (!blockState.hasBlockEntity()) {
+            if (true) return; // Archive - mute logspam
             // Paper start - ServerExceptionEvent
             com.destroystokyo.paper.exception.ServerInternalException e = new com.destroystokyo.paper.exception.ServerInternalException(
                 "Trying to set block entity %s at position %s, but state %s does not allow it".formatted(blockEntity, blockPos, blockState)
@@ -543,12 +544,12 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
             BlockState blockState1 = blockEntity.getBlockState();
             if (blockState != blockState1) {
                 if (!blockEntity.getType().isValid(blockState)) {
-                    LOGGER.warn("Trying to set block entity {} at position {}, but state {} does not allow it", blockEntity, blockPos, blockState);
+                    LOGGER.debug("Trying to set block entity {} at position {}, but state {} does not allow it", blockEntity, blockPos, blockState);
                     return;
                 }
 
                 if (blockState.getBlock() != blockState1.getBlock()) {
-                    LOGGER.warn("Block state mismatch on block entity {} in position {}, {} != {}, updating", blockEntity, blockPos, blockState, blockState1);
+                    LOGGER.debug("Block state mismatch on block entity {} in position {}, {} != {}, updating", blockEntity, blockPos, blockState, blockState1);
                 }
 
                 blockEntity.setBlockState(blockState);
